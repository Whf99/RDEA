{
  "release_type": "public-component-code",
  "paper_title": "Reliability-Driven Evidential Adaptation for Cross-Domain Medical Image Segmentation",
  "method": "RDEA",
  "components": {
    "SPPC": "structure-preserving paired-view construction",
    "ESIL": "evidence-induced selective invariance learning",
    "DEMH": "Dirichlet evidential matching and harmonization"
  },
  "input": {
    "representation": "2.5D adjacent-slice stack",
    "shape": "[batch, stacked_slices, height, width]",
    "example_slice_offsets": [-1, 0, 1]
  },
  "output": {
    "evidence": "[batch, classes, height, width]",
    "dirichlet_parameters": "[batch, classes, height, width]",
    "categorical_mean": "[batch, classes, height, width]",
    "uncertainty": "[batch, 1, height, width]",
    "mask": "[batch, height, width]"
  },
  "optimization": [
    "Stage I: SPPC paired-view construction",
    "Stage II: supervised + ESIL + DEMH optimization",
    "EMA teacher update after each student update",
    "EMA teacher inference"
  ],
  "evaluation_metrics": ["DSC", "ASSD", "ECE"],
  "public_implementation": [
    "paper-aligned training entry point and structured logging",
    "component topology and gradient-role plans",
    "evidence and Dirichlet transformations",
    "generic EMA and lifecycle validation",
    "DSC, ASSD, and ECE helpers"
  ]
}
